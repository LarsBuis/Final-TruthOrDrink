<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.GamePage">
    <StackLayout Padding="20">
        <Label x:Name="CurrentPlayerLabel" FontSize="Large" HorizontalOptions="Center" />
        <Label x:Name="QuestionLabel" FontSize="Medium" HorizontalOptions="Center" Margin="0,20,0,20" />

        <Button Text="Truth" Clicked="TruthButton_Clicked" HorizontalOptions="FillAndExpand" />
        <Button Text="Drink" Clicked="DrinkButton_Clicked" HorizontalOptions="FillAndExpand" Margin="0,10,0,0" />
    </StackLayout>
</ContentPage>